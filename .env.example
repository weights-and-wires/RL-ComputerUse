# Names of the variables the scripts read. Don't put values in this file.
# Real values live in ~/.api_keys on your Mac, as `export NAME=value` lines;
# scripts `source` that file at runtime and pass values to the pod as env vars.

RUNPOD_API_KEY=
HF_TOKEN=
WANDB_API_KEY=

# Optional settings
# HF repo for the trained adapter, for example YOUR_HF_USER/qwen3vl-4b-miniwob-grpo
HF_ADAPTER_REPO=
# Overrides results/ as the output root
CUA_RESULTS_DIR=
